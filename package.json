{
  "name": "enterprise-rag-agentic-pipeline",
  "version": "0.1.0",
  "description": "Production-grade RAG + agentic pipeline for source-cited answers over financial documents.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ingest": "tsx src/scripts/ingest-sample.ts",
    "eval": "tsx src/eval/run-eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run --config vitest.e2e.config.ts",
    "report:e2e": "vitest run --config vitest.e2e.config.ts && echo 'Open reports/e2e/index.html'",
    "report:view": "vite preview --outDir reports/e2e --open",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rag",
    "llm",
    "agentic-ai",
    "typescript",
    "vector-database",
    "devops"
  ],
  "author": "Dora Chintala",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@vitest/ui": "^2.1.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
