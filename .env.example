# Server
PORT=3000
LOG_LEVEL=info

# LLM / Embedding mode: "local" (free, no key) or "openai"
PROVIDER=local

# OpenAI (only needed if PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Vector store: "memory" (default, no deps) or "qdrant"
VECTOR_STORE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=financial_docs

# Retrieval
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=75
